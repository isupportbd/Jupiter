# ── App ────────────────────────────────────────────
APP_ENV=development
APP_NAME=nexgen
APP_PORT=3000
APP_URL=http://localhost:3000

# Frontend origin when UI is on a different domain than the API.
# Leave empty if UI is served from the same APP_URL.
FRONTEND_URL=

# ── Database ───────────────────────────────────────
# Supported: mysql://, postgres://, sqlite: prefix
DATABASE_URL=mysql://root:change-me-root@localhost:4000/nexgen

# ── Mail / SMTP ────────────────────────────────────
MAIL_HOST=mail.isupportbd.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=noreply@isupportbd.com
MAIL_PASSWORD=your_email_password
MAIL_FROM_ADDRESS=noreply@isupportbd.com
MAIL_FROM_NAME=IDP

# ── Secrets ────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
COOKIE_SECRET=change-me-cookie
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ── Redis ──────────────────────────────────────────
# Set true to enable cache, session, queue, events, and Queue Dashboard
REDIS=false
# Shared key prefix for cache, session, queue, events, and dashboards
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=nexgen

# ── Feature Toggle ─────────────────────────────────
# Set false for API-only mode (no UI build/serve)
UI=true
# Set true to enable OpenAPI / Scalar docs at /api-docs
OPEN_API=true
# Set false to disable Socket.IO realtime server
SOCKET=false
